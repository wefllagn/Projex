generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN

  @@map("user_role")
}

enum UserStatus {
  SETUP_PENDING
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("user_status")
}

enum AdminAuditAction {
  USER_STUDENT_PROVISIONED
  USER_INSTRUCTOR_PROVISIONED
  USER_SETUP_REISSUED
  USER_STATUS_CHANGED
  USER_SESSIONS_REVOKED
  CLASS_CREATED
  CLASS_UPDATED
  CLASS_ARCHIVED
  CLASS_RESTORED
  CLASS_JOIN_CODE_ROTATED
  CLASS_JOIN_CODE_REVOKED
  CLASS_MEMBER_REMOVED
  CLASS_MEMBER_REACTIVATED
}

enum AdminAuditTargetType {
  USER
  CLASS
  CLASS_MEMBER
}

enum ClassStatus {
  ACTIVE
  ARCHIVED

  @@map("class_status")
}

enum ClassMemberStatus {
  PENDING
  ACTIVE
  REMOVED

  @@map("class_member_status")
}

enum ProgrammingLanguage {
  JAVA

  @@map("programming_language")
}

enum ActivityStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED

  @@map("activity_status")
}

enum ProjectTaskStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED

  @@map("project_task_status")
}

enum SubmissionStatus {
  QUEUED
  ASSESSING
  ASSESSED
  ASSESSMENT_FAILED
  REVIEWED
  RELEASED
  FAILED_RESOLVED

  @@map("submission_status")
}

enum CompileStatus {
  PENDING
  SUCCESS
  STUDENT_ERROR
  INFRASTRUCTURE_ERROR

  @@map("compile_status")
}

enum RuntimeStatus {
  NOT_RUN
  PASSED
  FAILED
  TIMEOUT
  ERROR
  OUTPUT_LIMIT

  @@map("runtime_status")
}

enum TestCasePassStatus {
  PENDING
  PASSED
  FAILED
  ERROR
  TIMEOUT
  OUTPUT_LIMIT

  @@map("test_case_pass_status")
}

enum ExecutionJobType {
  OFFICIAL_ASSESSMENT
  VISIBLE_TEST_RUN

  @@map("execution_job_type")
}

enum ExecutionJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED

  @@map("execution_job_status")
}

enum FailureResolutionType {
  CLOSED_WITHOUT_REPLACEMENT
  REPLACEMENT_GRANTED

  @@map("failure_resolution_type")
}

enum PracticeExecutionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  TIMEOUT

  @@map("practice_execution_status")
}

enum RepositoryType {
  CLASS_PROJECT
  PERSONAL

  @@map("repository_type")
}

enum RepositoryVisibility {
  PRIVATE
  CLASS_ONLY
  PUBLIC

  @@map("repository_visibility")
}

enum RepositoryStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("repository_status")
}

enum RepositoryMemberRole {
  OWNER
  MEMBER
  VIEWER

  @@map("repository_member_role")
}

enum RepositoryMemberStatus {
  PENDING
  ACTIVE
  REMOVED

  @@map("repository_member_status")
}

enum RepositoryActivityType {
  REPOSITORY_PROVISIONED
  COMMIT
  PUSH
  MERGE
  BRANCH
  PULL
  OTHER

  @@map("repository_activity_type")
}

enum RepositoryActivityActorType {
  USER
  SYSTEM

  @@map("repository_activity_actor_type")
}

enum RepositoryStorageStatus {
  PENDING
  PROVISIONING
  READY
  FAILED
  QUARANTINED

  @@map("repository_storage_status")
}

enum RepositoryProvisioningJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED

  @@map("repository_provisioning_job_status")
}

enum GitCredentialOperation {
  READ
  WRITE

  @@map("git_credential_operation")
}

enum TeamStatus {
  ACTIVE
  ARCHIVED

  @@map("team_status")
}

enum TeamMemberRole {
  LEAD
  MEMBER

  @@map("team_member_role")
}

enum TeamMemberStatus {
  ACTIVE
  REMOVED

  @@map("team_member_status")
}

enum RepositoryReviewStatus {
  WORKING
  READY_FOR_REVIEW
  CHANGES_REQUESTED
  APPROVED

  @@map("repository_review_status")
}

enum RepositoryInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED

  @@map("repository_invitation_status")
}

enum RepositoryFeedbackStatus {
  DRAFT
  RELEASED

  @@map("repository_feedback_status")
}

model User {
  id                            String                        @id @default(uuid()) @map("user_id") @db.Uuid
  fullName                      String                        @map("full_name")
  email                         String                        @unique
  passwordHash                  String?                       @map("password_hash")
  role                          UserRole
  status                        UserStatus                    @default(SETUP_PENDING)
  createdAt                     DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                     DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)
  passwordChangedAt             DateTime?                     @map("password_changed_at") @db.Timestamptz(3)
  lastLoginAt                   DateTime?                     @map("last_login_at") @db.Timestamptz(3)
  accountSetupTokens            AccountSetupToken[]
  refreshSessions               RefreshSession[]              @relation("RefreshSessionUser")
  classesTaught                 Class[]                       @relation("ClassInstructor")
  classMemberships              ClassMember[]                 @relation("ClassMemberStudent")
  programmingActivitiesCreated  ProgrammingActivity[]         @relation("ProgrammingActivityCreator")
  activitySubmissions           ActivitySubmission[]          @relation("ActivitySubmissionStudent")
  submissionFeedbackAuthored    SubmissionFeedback[]          @relation("SubmissionFeedbackInstructor")
  submissionFeedbackReleased    SubmissionFeedback[]          @relation("SubmissionFeedbackReleaser")
  submissionIdempotencies       SubmissionIdempotency[]
  scoreCorrectionsAuthored      SubmissionScoreCorrection[]
  failureResolutionsAuthored    SubmissionFailureResolution[]
  practiceExecutions            PracticeExecution[]
  projectTasksCreated           ProjectTask[]                 @relation("ProjectTaskCreator")
  teamsLed                      Team[]                        @relation("TeamLead")
  teamMemberships               TeamMember[]                  @relation("TeamMemberStudent")
  repositoriesOwned             Repository[]                  @relation("RepositoryOwner")
  repositoryMemberships         RepositoryMember[]            @relation("RepositoryMemberStudent")
  repositoryInvitationsReceived RepositoryInvitation[]        @relation("RepositoryInvitationInvitee")
  repositoryInvitationsSent     RepositoryInvitation[]        @relation("RepositoryInvitationInviter")
  repositoryActivities          RepositoryActivity[]          @relation("RepositoryActivityUser")
  repositoryFeedbackAuthored    RepositoryFeedback[]          @relation("RepositoryFeedbackInstructor")
  repositoryFeedbackReleased    RepositoryFeedback[]          @relation("RepositoryFeedbackReleaser")
  gitCredentials                GitCredential[]
  adminAuditEvents              AdminAuditEvent[]              @relation("AdminAuditActor")

  @@index([role, status])
  @@map("users")
}

model AdminAuditEvent {
  id           String               @id @default(uuid()) @map("admin_audit_event_id") @db.Uuid
  actorAdminId String               @map("actor_admin_id") @db.Uuid
  action       AdminAuditAction
  targetType   AdminAuditTargetType @map("target_type")
  targetId     String?              @map("target_id") @db.Uuid
  reason       String?              @db.VarChar(500)
  requestId    String               @map("request_id") @db.Uuid
  metadataJson Json?                @map("metadata_json")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  actorAdmin   User                 @relation("AdminAuditActor", fields: [actorAdminId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([actorAdminId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("admin_audit_events")
}

model AccountSetupToken {
  id            String    @id @default(uuid()) @map("setup_token_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(3)
  invalidatedAt DateTime? @map("invalidated_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("account_setup_tokens")
}

model RefreshSession {
  id                  String          @id @default(uuid()) @map("refresh_session_id") @db.Uuid
  userId              String          @map("user_id") @db.Uuid
  familyId            String          @map("family_id") @db.Uuid
  tokenHash           String          @unique @map("token_hash")
  csrfTokenHash       String          @map("csrf_token_hash")
  expiresAt           DateTime        @map("expires_at") @db.Timestamptz(3)
  revokedAt           DateTime?       @map("revoked_at") @db.Timestamptz(3)
  replacedBySessionId String?         @unique @map("replaced_by_session_id") @db.Uuid
  userAgent           String?         @map("user_agent")
  ipAddress           String?         @map("ip_address")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt          DateTime?       @map("last_used_at") @db.Timestamptz(3)
  user                User            @relation("RefreshSessionUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  replacedBySession   RefreshSession? @relation("RefreshSessionReplacement", fields: [replacedBySessionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  replacesSession     RefreshSession? @relation("RefreshSessionReplacement")

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model Class {
  id                    String                @id @default(uuid()) @map("class_id") @db.Uuid
  instructorId          String                @map("instructor_id") @db.Uuid
  className             String                @map("class_name")
  classCode             String                @unique @map("class_code")
  section               String
  semester              String
  schoolYear            String                @map("school_year")
  status                ClassStatus           @default(ACTIVE)
  classCodeActive       Boolean               @default(true) @map("class_code_active")
  classCodeChangedAt    DateTime              @default(now()) @map("class_code_changed_at") @db.Timestamptz(3)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt            DateTime?             @map("archived_at") @db.Timestamptz(3)
  instructor            User                  @relation("ClassInstructor", fields: [instructorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  members               ClassMember[]
  programmingActivities ProgrammingActivity[]
  projectTasks          ProjectTask[]

  @@index([instructorId])
  @@index([status])
  @@index([semester, schoolYear])
  @@map("classes")
}

model ClassMember {
  id              String            @id @default(uuid()) @map("class_member_id") @db.Uuid
  classId         String            @map("class_id") @db.Uuid
  studentId       String            @map("student_id") @db.Uuid
  joinedAt        DateTime          @default(now()) @map("joined_at") @db.Timestamptz(3)
  status          ClassMemberStatus @default(ACTIVE)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  removedAt       DateTime?         @map("removed_at") @db.Timestamptz(3)
  lastActivatedAt DateTime          @default(now()) @map("last_activated_at") @db.Timestamptz(3)
  class           Class             @relation(fields: [classId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  student         User              @relation("ClassMemberStudent", fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([classId, studentId])
  @@index([studentId])
  @@index([classId, status])
  @@map("class_members")
}

model ProgrammingActivity {
  id                      String                  @id @default(uuid()) @map("activity_id") @db.Uuid
  classId                 String                  @map("class_id") @db.Uuid
  createdById             String                  @map("created_by") @db.Uuid
  title                   String
  instructions            String                  @db.Text
  dueDate                 DateTime                @map("due_date") @db.Timestamptz(3)
  language                ProgrammingLanguage     @default(JAVA)
  entryClassName          String                  @default("Main") @map("entry_class_name")
  starterCode             String                  @map("starter_code") @db.Text
  maxAttempts             Int                     @default(3) @map("max_attempts")
  totalPoints             Decimal                 @map("total_points") @db.Decimal(8, 2)
  status                  ActivityStatus          @default(DRAFT)
  createdAt               DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  publishedAt             DateTime?               @map("published_at") @db.Timestamptz(3)
  closedAt                DateTime?               @map("closed_at") @db.Timestamptz(3)
  archivedAt              DateTime?               @map("archived_at") @db.Timestamptz(3)
  class                   Class                   @relation(fields: [classId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy               User                    @relation("ProgrammingActivityCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  testCases               TestCase[]
  submissions             ActivitySubmission[]
  submissionIdempotencies SubmissionIdempotency[]
  practiceExecutions      PracticeExecution[]

  @@index([classId, status])
  @@index([dueDate])
  @@map("programming_activities")
}

model TestCase {
  id             String                  @id @default(uuid()) @map("test_case_id") @db.Uuid
  activityId     String                  @map("activity_id") @db.Uuid
  name           String
  testCaseOrder  Int                     @map("test_case_order")
  inputData      String?                 @map("input_data") @db.Text
  expectedOutput String                  @map("expected_output") @db.Text
  isHidden       Boolean                 @default(true) @map("is_hidden")
  points         Decimal                 @db.Decimal(8, 2)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  activity       ProgrammingActivity     @relation(fields: [activityId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  results        TestCaseResult[]
  practiceCases  PracticeExecutionCase[]

  @@unique([activityId, testCaseOrder])
  @@map("test_cases")
}

model ActivitySubmission {
  id                          String                       @id @default(uuid()) @map("submission_id") @db.Uuid
  activityId                  String                       @map("activity_id") @db.Uuid
  studentId                   String                       @map("student_id") @db.Uuid
  attemptNumber               Int                          @map("attempt_number")
  sourceCode                  String                       @map("source_code") @db.Text
  sourceHash                  String                       @map("source_hash")
  activityTitleSnapshot       String                       @map("activity_title_snapshot")
  dueDateSnapshot             DateTime                     @map("due_date_snapshot") @db.Timestamptz(3)
  totalPointsSnapshot         Decimal                      @map("total_points_snapshot") @db.Decimal(8, 2)
  automatedMaximum            Decimal                      @map("automated_maximum") @db.Decimal(8, 2)
  instructorMaximum           Decimal                      @map("instructor_maximum") @db.Decimal(8, 2)
  submittedAt                 DateTime                     @default(now()) @map("submitted_at") @db.Timestamptz(3)
  updatedAt                   DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  submissionStatus            SubmissionStatus             @default(QUEUED) @map("submission_status")
  isLate                      Boolean                      @default(false) @map("is_late")
  countsTowardAttemptLimit    Boolean                      @default(true) @map("counts_toward_attempt_limit")
  originalAutomatedScore      Decimal?                     @map("original_automated_score") @db.Decimal(8, 2)
  instructorPoints            Decimal                      @default(0) @map("instructor_points") @db.Decimal(8, 2)
  releasedFinalScore          Decimal?                     @map("released_final_score") @db.Decimal(8, 2)
  reviewedAt                  DateTime?                    @map("reviewed_at") @db.Timestamptz(3)
  releasedAt                  DateTime?                    @map("released_at") @db.Timestamptz(3)
  activity                    ProgrammingActivity          @relation(fields: [activityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  student                     User                         @relation("ActivitySubmissionStudent", fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  execution                   SubmissionExecution?
  executionJob                ExecutionJob?
  idempotency                 SubmissionIdempotency?
  scoreCorrections            SubmissionScoreCorrection[]
  failureResolution           SubmissionFailureResolution? @relation("FailedSubmissionResolution")
  replacementResolutionUsed   SubmissionFailureResolution? @relation("ReplacementSubmissionResolution")
  similarityResultsAsSource   SimilarityResult[]           @relation("SimilaritySourceSubmission")
  similarityResultsAsCompared SimilarityResult[]           @relation("SimilarityComparedSubmission")
  feedback                    SubmissionFeedback?

  @@unique([activityId, studentId, attemptNumber])
  @@index([studentId, submittedAt])
  @@index([activityId, submissionStatus])
  @@map("activity_submissions")
}

model SubmissionExecution {
  id                        String             @id @default(uuid()) @map("execution_id") @db.Uuid
  submissionId              String             @unique @map("submission_id") @db.Uuid
  compileStatus             CompileStatus      @default(PENDING) @map("compile_status")
  runtimeStatus             RuntimeStatus      @default(NOT_RUN) @map("runtime_status")
  compilerOutput            String?            @map("compiler_output") @db.Text
  infrastructureFailureCode String?            @map("infrastructure_failure_code")
  startedAt                 DateTime?          @map("started_at") @db.Timestamptz(3)
  completedAt               DateTime?          @map("completed_at") @db.Timestamptz(3)
  submission                ActivitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  testCaseResults           TestCaseResult[]

  @@index([submissionId, startedAt])
  @@map("submission_executions")
}

model TestCaseResult {
  id                     String              @id @default(uuid()) @map("test_case_result_id") @db.Uuid
  executionId            String              @map("execution_id") @db.Uuid
  testCaseId             String              @map("test_case_id") @db.Uuid
  testNameSnapshot       String              @map("test_name_snapshot")
  testOrderSnapshot      Int                 @map("test_order_snapshot")
  inputSnapshot          String?             @map("input_snapshot") @db.Text
  expectedOutputSnapshot String              @map("expected_output_snapshot") @db.Text
  isHiddenSnapshot       Boolean             @map("is_hidden_snapshot")
  maximumPoints          Decimal             @map("maximum_points") @db.Decimal(8, 2)
  passStatus             TestCasePassStatus  @default(PENDING) @map("pass_status")
  actualOutput           String?             @map("actual_output") @db.Text
  errorMessage           String?             @map("error_message") @db.Text
  automatedPoints        Decimal             @default(0) @map("automated_points") @db.Decimal(8, 2)
  executionTimeMs        Int?                @map("execution_time_ms")
  execution              SubmissionExecution @relation(fields: [executionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  testCase               TestCase            @relation(fields: [testCaseId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([executionId, testCaseId])
  @@index([testCaseId])
  @@map("test_case_results")
}

model SimilarityResult {
  id                   String             @id @default(uuid()) @map("similarity_id") @db.Uuid
  submissionId         String             @map("submission_id") @db.Uuid
  comparedSubmissionId String             @map("compared_submission_id") @db.Uuid
  similarityPercentage Decimal            @map("similarity_percentage") @db.Decimal(5, 2)
  remarks              String?
  generatedAt          DateTime           @default(now()) @map("generated_at") @db.Timestamptz(3)
  submission           ActivitySubmission @relation("SimilaritySourceSubmission", fields: [submissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  comparedSubmission   ActivitySubmission @relation("SimilarityComparedSubmission", fields: [comparedSubmissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([submissionId, comparedSubmissionId])
  @@index([comparedSubmissionId])
  @@map("similarity_results")
}

model SubmissionFeedback {
  id           String             @id @default(uuid()) @map("feedback_id") @db.Uuid
  submissionId String             @unique @map("submission_id") @db.Uuid
  instructorId String             @map("instructor_id") @db.Uuid
  releasedById String?            @map("released_by_id") @db.Uuid
  feedbackText String             @map("feedback_text") @db.Text
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  releasedAt   DateTime?          @map("released_at") @db.Timestamptz(3)
  submission   ActivitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  instructor   User               @relation("SubmissionFeedbackInstructor", fields: [instructorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  releasedBy   User?              @relation("SubmissionFeedbackReleaser", fields: [releasedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("submission_feedback")
}

model SubmissionIdempotency {
  id           String              @id @default(uuid()) @map("submission_idempotency_id") @db.Uuid
  studentId    String              @map("student_id") @db.Uuid
  activityId   String              @map("activity_id") @db.Uuid
  keyHash      String              @map("key_hash")
  payloadHash  String              @map("payload_hash")
  submissionId String              @unique @map("submission_id") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  student      User                @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  activity     ProgrammingActivity @relation(fields: [activityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  submission   ActivitySubmission  @relation(fields: [submissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([studentId, activityId, keyHash])
  @@map("submission_idempotencies")
}

model SubmissionScoreCorrection {
  id                     String             @id @default(uuid()) @map("score_correction_id") @db.Uuid
  submissionId           String             @map("submission_id") @db.Uuid
  correctionNumber       Int                @map("correction_number")
  originalAutomatedScore Decimal            @map("original_automated_score") @db.Decimal(8, 2)
  previousEffectiveScore Decimal            @map("previous_effective_score") @db.Decimal(8, 2)
  newEffectiveScore      Decimal            @map("new_effective_score") @db.Decimal(8, 2)
  reason                 String             @db.Text
  correctedById          String             @map("corrected_by_id") @db.Uuid
  correctedAt            DateTime           @default(now()) @map("corrected_at") @db.Timestamptz(3)
  submission             ActivitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  correctedBy            User               @relation(fields: [correctedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([submissionId, correctionNumber])
  @@index([correctedById, correctedAt])
  @@map("submission_score_corrections")
}

model SubmissionFailureResolution {
  id                      String                @id @default(uuid()) @map("failure_resolution_id") @db.Uuid
  failedSubmissionId      String                @unique @map("failed_submission_id") @db.Uuid
  resolutionType          FailureResolutionType @map("resolution_type")
  reason                  String                @db.Text
  resolvedById            String                @map("resolved_by_id") @db.Uuid
  resolvedAt              DateTime              @default(now()) @map("resolved_at") @db.Timestamptz(3)
  replacementExpiresAt    DateTime?             @map("replacement_expires_at") @db.Timestamptz(3)
  replacementSubmissionId String?               @unique @map("replacement_submission_id") @db.Uuid
  replacementConsumedAt   DateTime?             @map("replacement_consumed_at") @db.Timestamptz(3)
  failedSubmission        ActivitySubmission    @relation("FailedSubmissionResolution", fields: [failedSubmissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  replacementSubmission   ActivitySubmission?   @relation("ReplacementSubmissionResolution", fields: [replacementSubmissionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  resolvedBy              User                  @relation(fields: [resolvedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([resolvedById, resolvedAt])
  @@index([replacementExpiresAt])
  @@map("submission_failure_resolutions")
}

model ExecutionJob {
  id                  String              @id @default(uuid()) @map("execution_job_id") @db.Uuid
  jobType             ExecutionJobType    @map("job_type")
  submissionId        String?             @unique @map("submission_id") @db.Uuid
  practiceExecutionId String?             @unique @map("practice_execution_id") @db.Uuid
  status              ExecutionJobStatus  @default(QUEUED)
  claimAttempt        Int                 @default(0) @map("claim_attempt")
  maxClaimAttempts    Int                 @default(3) @map("max_claim_attempts")
  availableAt         DateTime            @default(now()) @map("available_at") @db.Timestamptz(3)
  claimedAt           DateTime?           @map("claimed_at") @db.Timestamptz(3)
  leaseExpiresAt      DateTime?           @map("lease_expires_at") @db.Timestamptz(3)
  completedAt         DateTime?           @map("completed_at") @db.Timestamptz(3)
  workerId            String?             @map("worker_id")
  lastFailureCode     String?             @map("last_failure_code")
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  submission          ActivitySubmission? @relation(fields: [submissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  practiceExecution   PracticeExecution?  @relation(fields: [practiceExecutionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([status, availableAt])
  @@index([leaseExpiresAt])
  @@map("execution_jobs")
}

model PracticeExecution {
  id             String                  @id @default(uuid()) @map("practice_execution_id") @db.Uuid
  activityId     String                  @map("activity_id") @db.Uuid
  studentId      String                  @map("student_id") @db.Uuid
  sourceCode     String                  @map("source_code") @db.Text
  sourceHash     String                  @map("source_hash")
  entryClassName String                  @map("entry_class_name")
  status         PracticeExecutionStatus @default(QUEUED)
  compileStatus  CompileStatus           @default(PENDING) @map("compile_status")
  runtimeStatus  RuntimeStatus           @default(NOT_RUN) @map("runtime_status")
  compilerOutput String?                 @map("compiler_output") @db.Text
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt      DateTime?               @map("started_at") @db.Timestamptz(3)
  completedAt    DateTime?               @map("completed_at") @db.Timestamptz(3)
  expiresAt      DateTime                @map("expires_at") @db.Timestamptz(3)
  activity       ProgrammingActivity     @relation(fields: [activityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  student        User                    @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cases          PracticeExecutionCase[]
  executionJob   ExecutionJob?

  @@index([studentId, createdAt])
  @@index([activityId, status])
  @@index([expiresAt])
  @@map("practice_executions")
}

model PracticeExecutionCase {
  id                     String             @id @default(uuid()) @map("practice_execution_case_id") @db.Uuid
  practiceExecutionId    String             @map("practice_execution_id") @db.Uuid
  testCaseId             String             @map("test_case_id") @db.Uuid
  testNameSnapshot       String             @map("test_name_snapshot")
  testOrderSnapshot      Int                @map("test_order_snapshot")
  inputSnapshot          String?            @map("input_snapshot") @db.Text
  expectedOutputSnapshot String             @map("expected_output_snapshot") @db.Text
  passStatus             TestCasePassStatus @default(PENDING) @map("pass_status")
  actualOutput           String?            @map("actual_output") @db.Text
  errorMessage           String?            @map("error_message") @db.Text
  executionTimeMs        Int?               @map("execution_time_ms")
  practiceExecution      PracticeExecution  @relation(fields: [practiceExecutionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  testCase               TestCase           @relation(fields: [testCaseId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([practiceExecutionId, testCaseId])
  @@unique([practiceExecutionId, testOrderSnapshot])
  @@map("practice_execution_cases")
}

model ProjectTask {
  id           String                 @id @default(uuid()) @map("project_task_id") @db.Uuid
  classId      String                 @map("class_id") @db.Uuid
  createdById  String                 @map("created_by") @db.Uuid
  title        String
  instructions String                 @db.Text
  dueDate      DateTime               @map("due_date") @db.Timestamptz(3)
  maxTeamSize  Int                    @default(4) @map("max_team_size")
  status       ProjectTaskStatus      @default(DRAFT)
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  publishedAt  DateTime?              @map("published_at") @db.Timestamptz(3)
  closedAt     DateTime?              @map("closed_at") @db.Timestamptz(3)
  archivedAt   DateTime?              @map("archived_at") @db.Timestamptz(3)
  class        Class                  @relation(fields: [classId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy    User                   @relation("ProjectTaskCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  teams        Team[]
  repositories Repository[]
  invitations  RepositoryInvitation[]

  @@index([classId, status])
  @@index([dueDate])
  @@map("project_tasks")
}

model Team {
  id             String                 @id @default(uuid()) @map("team_id") @db.Uuid
  projectTaskId  String                 @map("project_task_id") @db.Uuid
  leadStudentId  String                 @map("lead_student_id") @db.Uuid
  name           String                 @map("team_name")
  normalizedName String                 @map("normalized_name")
  status         TeamStatus             @default(ACTIVE)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt     DateTime?              @map("archived_at") @db.Timestamptz(3)
  projectTask    ProjectTask            @relation(fields: [projectTaskId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  leadStudent    User                   @relation("TeamLead", fields: [leadStudentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  members        TeamMember[]
  repository     Repository?
  invitations    RepositoryInvitation[]

  @@unique([id, projectTaskId])
  @@unique([id, leadStudentId])
  @@unique([projectTaskId, normalizedName])
  @@index([projectTaskId, status])
  @@index([leadStudentId, status])
  @@map("teams")
}

model TeamMember {
  id              String           @id @default(uuid()) @map("team_member_id") @db.Uuid
  teamId          String           @map("team_id") @db.Uuid
  projectTaskId   String           @map("project_task_id") @db.Uuid
  studentId       String           @map("student_id") @db.Uuid
  memberRole      TeamMemberRole   @map("member_role")
  status          TeamMemberStatus @default(ACTIVE)
  joinedAt        DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  removedAt       DateTime?        @map("removed_at") @db.Timestamptz(3)
  lastActivatedAt DateTime         @default(now()) @map("last_activated_at") @db.Timestamptz(3)
  team            Team             @relation(fields: [teamId, projectTaskId], references: [id, projectTaskId], onDelete: Cascade, onUpdate: Cascade)
  student         User             @relation("TeamMemberStudent", fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([teamId, studentId])
  @@index([projectTaskId, studentId, status])
  @@index([studentId, status])
  @@map("team_members")
}

model Repository {
  id                 String                     @id @default(uuid()) @map("repository_id") @db.Uuid
  projectTaskId      String?                    @map("project_task_id") @db.Uuid
  teamId             String?                    @unique @map("team_id") @db.Uuid
  ownerId            String                     @map("owner_id") @db.Uuid
  repositoryType     RepositoryType             @map("repository_type")
  repositoryName     String                     @map("repository_name")
  slug               String
  description        String?                    @db.Text
  storagePath        String?                    @unique @map("storage_path")
  storageStatus      RepositoryStorageStatus    @default(PENDING) @map("storage_status")
  provisionedAt      DateTime?                  @map("provisioned_at") @db.Timestamptz(3)
  storageVerifiedAt  DateTime?                  @map("storage_verified_at") @db.Timestamptz(3)
  storageSizeBytes   BigInt?                    @map("storage_size_bytes")
  storageFailureCode String?                    @map("storage_failure_code")
  defaultBranch      String                     @default("main") @map("default_branch")
  visibility         RepositoryVisibility
  status             RepositoryStatus           @default(ACTIVE)
  reviewStatus       RepositoryReviewStatus     @default(WORKING) @map("review_status")
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  readyForReviewAt   DateTime?                  @map("ready_for_review_at") @db.Timestamptz(3)
  approvedAt         DateTime?                  @map("approved_at") @db.Timestamptz(3)
  archivedAt         DateTime?                  @map("archived_at") @db.Timestamptz(3)
  projectTask        ProjectTask?               @relation(fields: [projectTaskId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  team               Team?                      @relation(fields: [teamId, projectTaskId], references: [id, projectTaskId], onDelete: Restrict, onUpdate: Cascade)
  owner              User                       @relation("RepositoryOwner", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  members            RepositoryMember[]
  invitations        RepositoryInvitation[]
  activities         RepositoryActivity[]
  feedback           RepositoryFeedback[]
  provisioningJob    RepositoryProvisioningJob?
  gitCredentials     GitCredential[]

  @@unique([teamId, projectTaskId])
  @@index([ownerId])
  @@index([projectTaskId])
  @@index([repositoryType, status])
  @@index([projectTaskId, reviewStatus])
  @@map("repositories")
}

model RepositoryProvisioningJob {
  id               String                          @id @default(uuid()) @map("provisioning_job_id") @db.Uuid
  repositoryId     String                          @unique @map("repository_id") @db.Uuid
  status           RepositoryProvisioningJobStatus @default(PENDING)
  claimAttempt     Int                             @default(0) @map("claim_attempt")
  maxClaimAttempts Int                             @default(3) @map("max_claim_attempts")
  availableAt      DateTime                        @default(now()) @map("available_at") @db.Timestamptz(3)
  claimedAt        DateTime?                       @map("claimed_at") @db.Timestamptz(3)
  leaseExpiresAt   DateTime?                       @map("lease_expires_at") @db.Timestamptz(3)
  completedAt      DateTime?                       @map("completed_at") @db.Timestamptz(3)
  workerId         String?                         @map("worker_id")
  lastFailureCode  String?                         @map("last_failure_code")
  quarantineKey    String?                         @map("quarantine_key")
  createdAt        DateTime                        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(3)
  repository       Repository                      @relation(fields: [repositoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([status, availableAt])
  @@index([leaseExpiresAt])
  @@map("repository_provisioning_jobs")
}

model GitCredential {
  id                String                   @id @default(uuid()) @map("git_credential_id") @db.Uuid
  userId            String                   @map("user_id") @db.Uuid
  repositoryId      String                   @map("repository_id") @db.Uuid
  secretHash        String                   @map("secret_hash")
  allowedOperations GitCredentialOperation[] @map("allowed_operations")
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt         DateTime                 @map("expires_at") @db.Timestamptz(3)
  lastUsedAt        DateTime?                @map("last_used_at") @db.Timestamptz(3)
  revokedAt         DateTime?                @map("revoked_at") @db.Timestamptz(3)
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  repository        Repository               @relation(fields: [repositoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, repositoryId, expiresAt])
  @@index([repositoryId, expiresAt])
  @@map("git_credentials")
}

model RepositoryMember {
  id              String                 @id @default(uuid()) @map("repository_member_id") @db.Uuid
  repositoryId    String                 @map("repository_id") @db.Uuid
  studentId       String                 @map("student_id") @db.Uuid
  memberRole      RepositoryMemberRole   @map("member_role")
  joinedAt        DateTime               @default(now()) @map("joined_at") @db.Timestamptz(3)
  status          RepositoryMemberStatus @default(ACTIVE)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  removedAt       DateTime?              @map("removed_at") @db.Timestamptz(3)
  lastActivatedAt DateTime               @default(now()) @map("last_activated_at") @db.Timestamptz(3)
  repository      Repository             @relation(fields: [repositoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  student         User                   @relation("RepositoryMemberStudent", fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([repositoryId, studentId])
  @@index([studentId, status])
  @@map("repository_members")
}

model RepositoryInvitation {
  id               String                     @id @default(uuid()) @map("invitation_id") @db.Uuid
  repositoryId     String                     @map("repository_id") @db.Uuid
  teamId           String                     @map("team_id") @db.Uuid
  projectTaskId    String                     @map("project_task_id") @db.Uuid
  inviteeId        String                     @map("invitee_id") @db.Uuid
  invitedById      String                     @map("invited_by_id") @db.Uuid
  status           RepositoryInvitationStatus @default(PENDING)
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt        DateTime                   @map("expires_at") @db.Timestamptz(3)
  acceptedAt       DateTime?                  @map("accepted_at") @db.Timestamptz(3)
  declinedAt       DateTime?                  @map("declined_at") @db.Timestamptz(3)
  revokedAt        DateTime?                  @map("revoked_at") @db.Timestamptz(3)
  expiredAt        DateTime?                  @map("expired_at") @db.Timestamptz(3)
  resolutionReason String?                    @map("resolution_reason") @db.Text
  repository       Repository                 @relation(fields: [repositoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  team             Team                       @relation(fields: [teamId, projectTaskId], references: [id, projectTaskId], onDelete: Cascade, onUpdate: Cascade)
  projectTask      ProjectTask                @relation(fields: [projectTaskId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  invitee          User                       @relation("RepositoryInvitationInvitee", fields: [inviteeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  invitedBy        User                       @relation("RepositoryInvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([repositoryId, status, expiresAt])
  @@index([inviteeId, status, expiresAt])
  @@index([projectTaskId, status, expiresAt])
  @@map("repository_invitations")
}

model RepositoryActivity {
  id                 String                      @id @default(uuid()) @map("repository_activity_id") @db.Uuid
  repositoryId       String                      @map("repository_id") @db.Uuid
  userId             String?                     @map("user_id") @db.Uuid
  actorType          RepositoryActivityActorType @default(USER) @map("actor_type")
  activityType       RepositoryActivityType      @map("activity_type")
  commitHash         String?                     @map("commit_hash")
  branchName         String?                     @map("branch_name")
  filePath           String?                     @map("file_path")
  oldPath            String?                     @map("old_path")
  newPath            String?                     @map("new_path")
  message            String?                     @db.Text
  metadataJson       Json?                       @map("metadata_json")
  activityAt         DateTime                    @default(now()) @map("activity_at") @db.Timestamptz(3)
  transportRequestId String?                     @unique @map("transport_request_id") @db.Uuid
  repository         Repository                  @relation(fields: [repositoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user               User?                       @relation("RepositoryActivityUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([repositoryId, activityAt])
  @@index([userId, activityAt])
  @@map("repository_activity")
}

model RepositoryFeedback {
  id           String                   @id @default(uuid()) @map("feedback_id") @db.Uuid
  repositoryId String                   @map("repository_id") @db.Uuid
  instructorId String                   @map("instructor_id") @db.Uuid
  releasedById String?                  @map("released_by_id") @db.Uuid
  feedbackText String                   @map("feedback_text") @db.Text
  grade        Decimal?                 @db.Decimal(8, 2)
  status       RepositoryFeedbackStatus @default(DRAFT)
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  releasedAt   DateTime?                @map("released_at") @db.Timestamptz(3)
  repository   Repository               @relation(fields: [repositoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  instructor   User                     @relation("RepositoryFeedbackInstructor", fields: [instructorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  releasedBy   User?                    @relation("RepositoryFeedbackReleaser", fields: [releasedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([repositoryId, status, createdAt])
  @@map("repository_feedback")
}
