NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://projex_user:replace_with_hosted_password@127.0.0.1:5432/projex?schema=public
FRONTEND_ORIGIN=https://projex.example.edu
LOG_LEVEL=info
REQUEST_BODY_LIMIT=1mb
TRUST_PROXY_HOPS=1
ACCESS_TOKEN_SECRET=replace_with_at_least_32_random_characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
SESSION_IDLE_TTL_MINUTES=30
ACCOUNT_SETUP_TOKEN_TTL_HOURS=24
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax
MAIL_TRANSPORT=smtp
MAIL_FROM_NAME=Projex
MAIL_FROM_ADDRESS=no-reply@projex.example.edu
MAIL_PREVIEW_DIR=.mail-preview
SMTP_HOST=smtp.example.edu
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=replace_with_smtp_user
SMTP_PASSWORD=replace_with_smtp_password
JAVA_EXECUTION_MODE=disabled
GIT_EXECUTION_MODE=disabled
GIT_SMART_HTTP_ENABLED=false
