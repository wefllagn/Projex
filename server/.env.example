NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://projex_user:replace_with_local_password@localhost:5432/projex?schema=public
SHADOW_DATABASE_URL=postgresql://projex_user:replace_with_local_password@localhost:5432/projex_shadow?schema=public
TEST_DATABASE_URL=postgresql://projex_test_user:replace_with_test_password@localhost:5432/projex_test?schema=public
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=info
REQUEST_BODY_LIMIT=1mb

ACCESS_TOKEN_SECRET=replace_with_a_long_random_secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
ACCOUNT_SETUP_TOKEN_TTL_HOURS=24
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

MAIL_TRANSPORT=preview
MAIL_FROM_NAME=Projex
MAIL_FROM_ADDRESS=no-reply@projex.local
MAIL_PREVIEW_DIR=.mail-preview

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Java execution is disabled by default. local_process is development-only.
JAVA_EXECUTION_MODE=disabled
JAVA_EXECUTABLE=java
JAVAC_EXECUTABLE=javac
JAVA_RELEASE=17
JAVA_JOB_ROOT=.java-jobs
JAVA_SOURCE_LIMIT_BYTES=100000
JAVA_COMPILE_TIMEOUT_MS=10000
JAVA_TEST_TIMEOUT_MS=3000
JAVA_OUTPUT_LIMIT_BYTES=65536
JAVA_MEMORY_LIMIT_MB=64
EXECUTION_JOB_LEASE_MS=60000
EXECUTION_WORKER_POLL_MS=1000
PRACTICE_RUN_TTL_HOURS=24
PRACTICE_RUNS_PER_MINUTE=5
PRACTICE_MAX_ACTIVE_PER_ACTIVITY=1

# Local Git is disabled by default. Use absolute paths only in controlled development.
GIT_EXECUTION_MODE=disabled
GIT_EXECUTABLE=
GIT_STORAGE_ROOT=
GIT_COMMAND_TIMEOUT_MS=30000
GIT_OUTPUT_LIMIT_BYTES=1048576
GIT_REPOSITORY_SIZE_LIMIT_BYTES=104857600
GIT_PROVISIONING_JOB_LEASE_MS=60000
GIT_PROVISIONING_WORKER_POLL_MS=1000
GIT_PROVISIONING_MAX_ATTEMPTS=3
GIT_SMART_HTTP_ENABLED=false
GIT_HTTP_BACKEND_EXECUTABLE=
GIT_CREDENTIAL_TTL_MINUTES=15
GIT_HTTP_REQUEST_LIMIT_BYTES=26214400
GIT_HTTP_RESPONSE_LIMIT_BYTES=115343360
GIT_HTTP_TIMEOUT_MS=60000
GIT_HTTP_MAX_CONCURRENT=4
GIT_MAX_BRANCHES=100
GIT_MAX_REF_UPDATES=50
GIT_MAX_NEW_COMMITS=200
GIT_BLOB_LIMIT_BYTES=10485760
GIT_INSPECTION_FILE_LIMIT_BYTES=262144
GIT_INSPECTION_DIFF_LIMIT_BYTES=524288
GIT_INSPECTION_MAX_CHANGED_FILES=500

# Real-Git tests require an explicit isolated root ending in projex_git_test.
TEST_GIT_STORAGE_ROOT=

INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
