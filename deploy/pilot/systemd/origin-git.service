[Unit]
Description=Origin git pilot service
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=origin
Group=origin
WorkingDirectory=/opt/origin/current/server
EnvironmentFile=/etc/origin/pilot.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStartPre=/usr/local/bin/node dist/scripts/deployment-preflight.js --scope=git
ExecStart=/usr/local/bin/node dist/git-worker.js
Restart=on-failure
RestartSec=10
TimeoutStopSec=3600
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/origin/git
MemoryMax=384M
TasksMax=256
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
