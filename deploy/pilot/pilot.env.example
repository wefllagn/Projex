# Copy to /etc/origin/pilot.env, root:root 0600. Never commit the populated file.
# Plain KEY=value syntax; no shell expansions. Quote values containing spaces.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
FRONTEND_ORIGIN=https://REPLACE_WITH_YOUR_DOMAIN
DATABASE_URL=postgresql://origin_pilot:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/origin_pilot?schema=public
ACCESS_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax
TRUST_PROXY_HOPS=1
SESSION_IDLE_TTL_MINUTES=30
LOG_LEVEL=info
MAIL_TRANSPORT=smtp
MAIL_FROM_NAME=Origin
MAIL_FROM_ADDRESS=REPLACE_WITH_VERIFIED_SENDER
SMTP_HOST=REPLACE_WITH_EXISTING_SMTP_PROVIDER
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
JAVA_EXECUTION_MODE=container
JAVA_DOCKER_EXECUTABLE=/usr/bin/docker
# Set to the local image ID produced by build-java-image.sh; never a mutable tag.
JAVA_DOCKER_IMAGE=sha256:REPLACE_WITH_64_HEX_DIGEST
JAVA_EXECUTABLE=java
JAVAC_EXECUTABLE=javac
JAVA_RELEASE=17
JAVA_JOB_ROOT=/var/lib/origin-java/jobs
JAVA_MEMORY_LIMIT_MB=64
JAVA_COMPILE_TIMEOUT_MS=10000
JAVA_TEST_TIMEOUT_MS=3000
JAVA_OUTPUT_LIMIT_BYTES=65536
EXECUTION_JOB_LEASE_MS=300000
GIT_EXECUTION_MODE=service_isolated
GIT_EXECUTABLE=/usr/bin/git
GIT_STORAGE_ROOT=/var/lib/origin/git
GIT_SMART_HTTP_ENABLED=false
